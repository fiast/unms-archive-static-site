# Шаблон конфигурации. Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env
# Файл .env находится в .gitignore и в репозиторий не попадает.

# ---------------------------------------------------------------------------
# UISP CRM — абоненты (export_crm_clients.py)
# ---------------------------------------------------------------------------
CRM_API_URL=https://crm.example.com/crm/api/v1.0/
# App Key (UISP CRM -> Settings -> Security -> App keys -> Read)
CRM_API_KEY=

# ---------------------------------------------------------------------------
# UISP NMS — сайты и устройства (export_uisp_topology.py)
# ---------------------------------------------------------------------------
NMS_API_URL=https://nms.example.com/nms/api/v2.1
# Токен авторизации (UISP NMS -> пользователь -> токены)
NMS_API_TOKEN=

# ---------------------------------------------------------------------------
# Каталоги (относительные пути считаются от корня репозитория)
# ---------------------------------------------------------------------------
OUTPUT_DIR=output

# ---------------------------------------------------------------------------
# Публикация статики в docker-контейнер nginx по ssh
# ---------------------------------------------------------------------------
DEPLOY_HOST=192.0.2.10
DEPLOY_PORT=22
DEPLOY_USER=deploy
DEPLOY_DIR=/var/www/uisp-static
DEPLOY_HTTPS_PORT=6443
DEPLOY_CONTAINER=uisp-static-archive
DEPLOY_AUTH_REALM=UNMS Bill Archive
# Через запятую. Пустое значение -> доступ без IP-фильтра.
DEPLOY_ALLOWED_SUBNETS=127.0.0.0/8
PUBLIC_URL=https://192.0.2.10:6443/
DOCKER_COMPOSE_CMD=docker compose

# Учётные данные basic-auth для nginx. Если оставить пустыми,
# логин/пароль генерируются случайно при каждой сборке бандла.
DEPLOY_AUTH_LOGIN=
DEPLOY_AUTH_PASSWORD=

# Проверки после публикации: файл сайта (без .html) и маркер в index.html
PUBLISH_CHECK_SITE=истрия
PUBLISH_CHECK_MARKER=Индекс сайтов

# ---------------------------------------------------------------------------
# Внешние ресурсы страниц (CDN) — при необходимости можно переопределить
# ---------------------------------------------------------------------------
CDN_BOOTSTRAP_CSS=https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css
CDN_FONT_AWESOME_CSS=https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css
CDN_BOOTSTRAP_JS=https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js
CDN_JQUERY=https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js
CDN_DATATABLES_CSS=https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css
CDN_DATATABLES_RESP_CSS=https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css
CDN_DATATABLES_JS=https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js
CDN_DATATABLES_BS5_JS=https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js
CDN_DATATABLES_RESP_JS=https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js
CDN_MERMAID_JS=https://cdnjs.cloudflare.com/ajax/libs/mermaid/10.9.1/mermaid.min.js
